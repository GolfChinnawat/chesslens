{
  "name": "chesslens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run engine:assets && vite",
    "build": "tsc --noEmit && npm run engine:assets && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "engine:assets": "node scripts/copy-engine.mjs",
    "lint": "eslint .",
    "test": "npm run engine:assets && vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "chess.js": "1.4.0",
    "react": "18.3.1",
    "react-chessboard": "4.7.3",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "stockfish": "17.1.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
